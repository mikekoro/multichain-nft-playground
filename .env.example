# `npm run wallets` writes these to .env.local (throwaway testnet keys). Never commit real ones.
# XRPL family seed (s…)
VITE_XRPL_SEED=
# XRPL classic address (r…), never funded: the unactivated destination for negative tests
VITE_XRPL_SPARE=
# EVM private key, 0x + 64 hex
VITE_EVM_KEY=
# Solana 64-byte secret key, base64
VITE_SOLANA_SECRET=
# Stellar secret (S…)
VITE_STELLAR_SECRET=
# optional: mainnet points every chain at mainnet (real funds); anything else = testnets
VITE_NETWORK=
