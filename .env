# Public endpoints, committed. No secrets here: keys go in .env.local (see .env.example), which also overrides any line below.
# Each name has a _MAINNET twin, used when VITE_NETWORK=mainnet.
VITE_XRPL_RPC=wss://s.altnet.rippletest.net:51233
VITE_XRPL_RPC_MAINNET=wss://xrplcluster.com
VITE_EVM_RPC_BASESEPOLIA=https://sepolia.base.org
VITE_EVM_RPC_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
VITE_EVM_RPC_ARBITRUM_MAINNET=https://arb1.arbitrum.io/rpc
VITE_SOLANA_RPC=https://api.devnet.solana.com
# The public mainnet RPC refuses browsers (403): override with a Helius (or other) URL in .env.local.
VITE_SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com
# Optional DAS-capable RPC (e.g. Helius) for compressed NFTs; empty = compressed NFTs can't be read or sent.
VITE_SOLANA_DAS_RPC=
VITE_SOLANA_DAS_RPC_MAINNET=
VITE_STELLAR_HORIZON=https://horizon-testnet.stellar.org
VITE_STELLAR_HORIZON_MAINNET=https://horizon.stellar.org
VITE_SOROBAN_RPC=https://soroban-testnet.stellar.org
VITE_SOROBAN_RPC_MAINNET=https://mainnet.sorobanrpc.com
VITE_STELLAR_FRIENDBOT=https://friendbot.stellar.org
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/
VITE_IPFS_GATEWAY_MAINNET=https://ipfs.io/ipfs/
